<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Apple Notes (iOS 17, light), as refined in notes/mockups/index.html;
         the names match the mockups' CSS. -->
    <color name="page">#F2F2F7</color>
    <color name="card">#FFFFFF</color>
    <color name="ink">#000000</color>
    <!-- A row's date. -->
    <color name="ink2">#3C3C43</color>
    <!-- Previews, counts, the note's date: deeper than iOS's #8A8A8E to be read at 11.5sp here. -->
    <color name="muted">#6E6E73</color>
    <color name="rule">#C6C6C8</color>
    <!-- Notes' yellow: icons and the caret; deepened where it is small text. -->
    <color name="tint">#E0A500</color>
    <color name="tint_text">#B88600</color>
    <!-- The d-pad's row. -->
    <color name="wash">#FFE9A6</color>
    <!-- A search match. -->
    <color name="mark">#FFD84D</color>
    <color name="field">#E3E3E8</color>
    <color name="bar">#F9F9F9</color>
    <color name="red">#FF3B30</color>
    <color name="chevron">#C4C4C7</color>
    <color name="menu">#FAFAFA</color>
    <color name="menu_rule">#DCDCE0</color>
    <color name="menu_gap">#E5E5EA</color>
    <color name="scrim">#38000000</color>
    <color name="read_only">#333333</color>
</resources>
