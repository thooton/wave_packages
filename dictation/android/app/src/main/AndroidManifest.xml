<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Microphone is opened strictly while dictation is actively running and
         closed immediately on stop. No INTERNET permission: fully offline. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:allowBackup="true"
        android:extractNativeLibs="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".NoticesActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Bound by the XT9IME keyboard mod via raw Binder IPC. Enforces caller UID. -->
        <service
            android:name=".DictationService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.dictation.xp3.ACTION_DICTATION_SERVICE" />
            </intent-filter>
        </service>

        <!-- Fast read-only state probe so the keyboard checks isEnabled without binding. -->
        <provider
            android:name=".DictationStateProvider"
            android:authorities="com.dictation.xp3.state"
            android:exported="true" />

        <!-- Explicit debug-only WAV input path, OFF by default. Protected by DUMP so
             only adb shell / root can trigger it for automated benchmarking. -->
        <receiver
            android:name=".DictationDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.dictation.xp3.DEBUG_WAV" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
