#!/sbin/sh
umask 022
OUTFD=$2
ZIPFILE=$3
ui_print() { echo "$1"; }
mount /data 2>/dev/null
[ -f /data/adb/magisk/util_functions.sh ] || { ui_print '! Magisk required'; exit 1; }
. /data/adb/magisk/util_functions.sh
[ "$MAGISK_VER_CODE" -ge 24000 ] || { ui_print '! Magisk 24.0+ required'; exit 1; }
install_module
exit 0
