<resources>
    <!-- The family look (DESIGN.md) in one hue, a library binding's
         oxblood: a deep header and status bar, the accent on focus and the
         one main action, a pale wash under the d-pad, and greys tinted
         toward it. The dim header text is over 7:1 on the header, the accent
         over 4.5:1 on its wash, and muted text over 4.8:1 on white. -->
    <color name="primary">#3B1A24</color>
    <color name="primary_dark">#3B1A24</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="on_primary_dim">#D8BAC3</color>

    <color name="row">#FFFFFF</color>
    <color name="section_fill">#F3EDEF</color>
    <color name="grouped_page">#F4F0F1</color>
    <color name="divider">#E6DCDF</color>
    <color name="field_fill">#F3EDEF</color>
    <color name="code_fill">#F3EDEF</color>

    <color name="focus_rule">#8C2F4A</color>
    <color name="focus_fill">#F8ECEF</color>
    <color name="press_fill">#F0D9DF</color>
    <color name="highlight">#248C2F4A</color>

    <color name="text">#1F1A1C</color>
    <color name="text_muted">#6E5F64</color>
</resources>
