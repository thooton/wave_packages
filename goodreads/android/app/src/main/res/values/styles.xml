<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- White pages under the site's beige header, dark status icons. -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/beige</item>
        <item name="android:colorPrimaryDark">@color/beige</item>
        <item name="android:colorAccent">@color/green</item>
        <item name="android:colorControlHighlight">@color/focus</item>
        <item name="android:statusBarColor">@color/beige</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/beige</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted</item>
    </style>
</resources>
