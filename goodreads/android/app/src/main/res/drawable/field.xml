<?xml version="1.0" encoding="utf-8"?>
<!-- The search box, as the site's header sets it: white, a beige-grey edge, brown when it has the keys. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="@color/page" />
            <stroke android:width="2dp" android:color="@color/brown" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="@color/page" />
            <stroke android:width="1dp" android:color="@color/beige_rule" />
        </shape>
    </item>
</selector>
